# Copy this file to .env.local and fill in the values.
# See supabase/README.md for where to find each one.

# Public URL of the site. Use http://localhost:3000 locally and your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL: Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_).
# Dashboard > Project Settings > API Keys > Publishable key.
# This key is safe to expose in the browser. Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show built-in sample content while a table is empty.
# "true"  = sample content appears for any table with no published rows (default)
# "false" = never show sample content, empty tables render empty sections
NEXT_PUBLIC_USE_MOCK_DATA=true
